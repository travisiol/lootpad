# Deployer key for `npm run deploy:robinhood`. Never commit a real one.
DEPLOYER_PRIVATE_KEY=

# Robinhood Chain
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_EXPLORER_API_URL=https://robinhoodchain.blockscout.com/api
ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Pons V2 factory on Robinhood Chain (the deploy script defaults to this).
PONS_FACTORY_ADDRESS=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e

# Reuse an already deployed ChestFactory instead of deploying a new one.
CHEST_FACTORY_ADDRESS=
# Where the pad's 10% goes. Defaults to the deployer.
TREASURY_ADDRESS=
# Final owner of the router (a multisig in production). Defaults to the deployer.
OWNER_ADDRESS=
# Pad launch fee in ETH, charged on top of the Pons launch fee. Zero.
PAD_LAUNCH_FEE_ETH=0
