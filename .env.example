# The Lootpad router on Robinhood Chain. Leave empty to use the address in
# contracts/deployments/robinhood.json (written by `npm run deploy:robinhood`);
# with neither, the site shows clean empty states and the launch form stays closed.
NEXT_PUBLIC_LOOTPAD_ROUTER=

# Robinhood Chain (defaults shown)
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Pons launch fee, display only; the router reads the live value.
NEXT_PUBLIC_LAUNCH_FEE_ETH=0.0005

# Token image uploads (optional — creators can always paste an image URL).
# A Pinata JWT pins uploads to IPFS; or an endpoint taking multipart `image`
# and answering { uri }. Pons' own /api/ipfs/image is origin-gated.
PINATA_JWT=
PONS_IPFS_UPLOAD_URL=

# Rehearsal only: an unlocked hardhat account, shown as a "fork wallet"
# connector that forwards transactions unsigned. Never set in production.
NEXT_PUBLIC_FORK_WALLET=

NEXT_PUBLIC_SITE_URL=https://lootpad.fun
NEXT_PUBLIC_X_URL=https://x.com/lootpad
